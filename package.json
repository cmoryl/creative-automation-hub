{
  "name": "creative-automation-platform",
  "version": "3.0.0-alpha",
  "private": true,
  "description": "AI-native creative automation platform for Claude, Illustrator, InDesign, Canva, and hybrid workflows.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "npm --workspace apps/desktop run dev",
    "desktop:build": "npm --workspace apps/desktop run build",
    "desktop:build:renderer": "npm --workspace apps/desktop run build:renderer",
    "desktop:build:main": "npm --workspace apps/desktop run build:main",
    "electron": "npm --workspace apps/desktop run electron",
    "electron:dev": "npm --workspace apps/desktop run electron:dev",
    "desktop:dist": "npm --workspace apps/desktop run dist",
    "desktop:dist:dmg": "npm --workspace apps/desktop run dist:dmg",
    "desktop:dist:zip": "npm --workspace apps/desktop run dist:zip",
    "typecheck": "npm --workspace apps/desktop run typecheck:all",
    "lint:structure": "node scripts/validate-structure.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "latest",
    "@lovable.dev/cloud-auth-js": "latest",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-aspect-ratio": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-collapsible": "latest",
    "@radix-ui/react-context-menu": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-hover-card": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-menubar": "latest",
    "@radix-ui/react-navigation-menu": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-radio-group": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slider": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toggle": "latest",
    "@radix-ui/react-toggle-group": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "ai": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "latest",
    "embla-carousel-react": "latest",
    "file-saver": "latest",
    "input-otp": "latest",
    "jszip": "latest",
    "lucide-react": "^0.468.0",
    "papaparse": "latest",
    "react": "^18.3.1",
    "react-day-picker": "latest",
    "react-dom": "^18.3.1",
    "react-hook-form": "latest",
    "react-resizable-panels": "latest",
    "recharts": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "vaul": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@lovable.dev/vite-tanstack-config": "latest",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}