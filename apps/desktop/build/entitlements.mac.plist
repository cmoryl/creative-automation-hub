<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's JS JIT compiler -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for Electron's memory management -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Needed to load native node modules and the engines folder -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound network for Canva, Figma, Monday.com, Claude APIs -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Open/save files via dialogs -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Access files in ~/Documents for workspace -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <!-- AppleScript automation (Illustrator, InDesign) -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
